# Optional future sources only; current radar/warnings/NLCD need no API keys.
# Deferred ACS tract estimates; see docs/CENSUS_TRACTS.md.
# Copy to .env and enter keys locally. Never commit the populated file.
CENSUS_API_KEY=

# Deferred ERA5 only; not needed for the default collection. See docs/ERA5.md.
# Optional alternative to ~/.cdsapirc; configure CDS access and accept ERA5 terms.
CDSAPI_KEY=
